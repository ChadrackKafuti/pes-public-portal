# Copy to .env (gitignored) and fill in. See docs/credentials.md.
CAFI_RS_PES_API_BASE=https://api.cafi-pse.org
CAFI_RS_PES_OIDC_TOKEN_URL=https://keycloak.cafi-pse.org/realms/UNPES/protocol/openid-connect/token
CAFI_RS_PES_CLIENT_ID=arcgis-pes-client
CAFI_RS_PES_CLIENT_SECRET=
# The PES realm uses the password grant: a service user's credentials.
CAFI_RS_PES_USERNAME=
CAFI_RS_PES_PASSWORD=
# CAFI_RS_PES_GRANT_TYPE=password   # default; set client_credentials if the realm changes
CAFI_RS_DATABASE_URL=postgresql://cafi:cafi@localhost:5432/cafi_rs
CAFI_RS_GEE_SERVICE_ACCOUNT=rs-pipeline@cafi-rs-platform.iam.gserviceaccount.com
# Local only (production uses workload identity instead of a key file):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/gee-key.json
