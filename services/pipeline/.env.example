# Copy to .env (gitignored) and fill in. See docs/credentials.md.
CAFI_RS_PES_API_BASE=https://pes.example.org
CAFI_RS_PES_OIDC_TOKEN_URL=https://sso.example.org/realms/pes/protocol/openid-connect/token
CAFI_RS_PES_CLIENT_ID=cafi-rs-platform
