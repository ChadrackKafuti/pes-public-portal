// ============================================================
//  Zoning popup — one expression for CB_Concession_Zoning (2), CB_Community_Forest_Zoning (4)
//  and CB_Local_Territory_Zoning (6); the parent layer is derived from $feature.layer.
//  Reads the parent layer and the sibling zones FROM THE WEB MAP by name (or SOURCE = "portal").
// ============================================================
Expects($feature, "*")

var SOURCE     = "map"
var PORTAL_URL = "https://geosmart.undp.org/arcgis"
var ITEM_ID    = "8e3638153ad74d2f8df9a4656bec5bb0"   // item "Other areas of interest" (Hosted/Protected_areas)
var PARENT = { "concession_zoning": ["CB_Logging_Concessions", 1, "Concession / titre forestier", "#5d4037"],
               "community_forest_zoning": ["CB_Community_Forests", 3, "Forêt communautaire", "#1b5e20"],
               "local_territory_zoning": ["CB_Local_Territories", 5, "Terroir villageois (PSAT)", "#37474f"] }
var SELF = { "concession_zoning": ["CB_Concession_Zoning", 2], "community_forest_zoning": ["CB_Community_Forest_Zoning", 4], "local_territory_zoning": ["CB_Local_Territory_Zoning", 6] }

function isBlank(x) { return IsEmpty(x) || Text(x) == "" || Text(x) == "null" }
function txt(x) { if (isBlank(x)) { return "" } var s = Text(x); s = Replace(s, "&", "&amp;"); s = Replace(s, "<", "&lt;"); return Replace(s, ">", "&gt;") }
function haTxt(x) { if (isBlank(x)) { return "" } var n = Number(x); if (IsNan(n) || n <= 0) { return "" } return Text(Round(n, 0), "#,###") + " ha" }
function dateTxt(x) { if (IsEmpty(x)) { return "" } return Text(Date(x), "DD MMM YYYY") }
function cat(dict, key, dflt) { if (!isBlank(key) && HasKey(dict, key)) { return dict[key] } return dflt }
function fsGet(name, id, fields, geom) {
  // "portal" mode: read the sub-layer of the service by item id
  if (SOURCE == "portal" && ITEM_ID != "PASTE_ITEM_ID_HERE") { return FeatureSetByPortalItem(Portal(PORTAL_URL), ITEM_ID, id, fields, geom) }
  // "map" mode: Map Viewer titles a sub-layer added from a service "<service> - <layer>", so try the usual variants
  var cands = [name, "Other areas of interest - " + name, "CB_Forest_Consolidated - " + name, "CB Forest Consolidated - " + name, Replace(name, "_", " "), "CB_Forest_Consolidated - " + Replace(name, "_", " ")]
  for (var i in cands) {
    var fs = FeatureSetByName($map, cands[i], fields, geom)
    if (!IsEmpty(fs)) { return fs }
  }
  if (ITEM_ID != "PASTE_ITEM_ID_HERE") { return FeatureSetByPortalItem(Portal(PORTAL_URL), ITEM_ID, id, fields, geom) }
  return null
}
function row(label, value) {
  if (isBlank(value)) { return "" }
  return "<tr><td style=\"color:#666; width:44%; padding:4px 6px 4px 0; font-size:12px; vertical-align:top;\">" + label + "</td><td style=\"font-weight:600; font-size:12px; padding:4px 0; vertical-align:top;\">" + value + "</td></tr>"
}
function table(rows) { if (isBlank(rows)) { return "" } return "<table style=\"width:100%; border-collapse:collapse;\">" + rows + "</table>" }
function section(title, accent, body) {
  if (isBlank(body)) { return "" }
  return "<div style=\"background:#f7fafa; border-left:4px solid " + accent + "; border-radius:4px; margin-bottom:10px; padding:8px 10px 8px 8px;\">"
       + "<div style=\"font-size:10px; font-weight:700; color:" + accent + "; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:8px;\">" + title + "</div>" + body + "</div>"
}
function chip(label, bg, fg) { return "<div style=\"background:" + bg + "; color:" + fg + "; padding:5px 10px; border-radius:6px; font-size:11px; font-weight:700;\">" + label + "</div>" }
function tile(value, label, color) {
  return "<div style=\"flex:1 1 30%; min-width:80px; background:#f5f9f9; border:1px solid #e0e0e0; border-radius:6px; padding:8px 4px; text-align:center;\">"
       + "<div style=\"font-size:16px; font-weight:700; color:" + color + ";\">" + value + "</div><div style=\"font-size:9px; color:#666; text-transform:uppercase; letter-spacing:0.5px; margin-top:2px;\">" + label + "</div></div>"
}

var ZONE = { "production": ["Production", "#c98a2b", "Exploitation forestière / production ligneuse"], "conservation": ["Conservation", "#2e7d32", "Conservation de la biodiversité"],
  "protection": ["Protection", "#00695c", "Protection (berges, pentes, sites sacrés, aires protégées)"], "community_development": ["Développement rural / communautaire", "#a0522d", "Usages des communautés (chasse, pêche, cueillette, PFNL)"],
  "agriculture": ["Agriculture", "#d4b106", "Cultures, élevage, agroforesterie, pisciculture"], "habitat": ["Habitat", "#8d6e63", "Villages, campements"],
  "savanna_protection": ["Mise en défens / reboisement", "#7cb342", "Savanes mises en défens, reboisement, RNA"], "concession": ["Zone concédée", "#5d4037", "Concessions et titres tiers"],
  "community_forest": ["Forêt communautaire", "#43a047", "CFCL / forêt des communautés locales"], "conflict": ["Zone conflictuelle", "#d32f2f", "Litiges"],
  "research": ["Recherche", "#7e57c2", "Recherche scientifique"], "unclassified": ["Non classée", "#bdbdbd", "Zonage non renseigné dans la source"], "other": ["Autre", "#607d8b", "Autre affectation"] }
var STATUS = { "attributed": ["Attribuée / validée", "#e8f5e9", "#2e7d32"], "provisional": ["Provisoire", "#fff8e1", "#ff8f00"], "final": ["Définitive", "#e8f5e9", "#1b5e20"], "in_process": ["En cours", "#e3f2fd", "#1565c0"],
  "not_attributed": ["Non attribuée", "#eceff1", "#607d8b"], "rejected": ["Rejetée", "#ffebee", "#c62828"], "expired": ["Expirée", "#efebe9", "#6d4c41"], "unknown": ["Non renseigné", "#eceff1", "#546e7a"] }
var FLAG = { "CMR": "🇨🇲", "CAF": "🇨🇫", "COD": "🇨🇩", "COG": "🇨🇬", "GNQ": "🇬🇶", "GAB": "🇬🇦" }

var f = $feature
var lay = DefaultValue(f.layer, "concession_zoning")
var P = cat(PARENT, lay, ["CB_Logging_Concessions", 1, "Unité parente", "#5d4037"])
var S = cat(SELF, lay, ["CB_Concession_Zoning", 2])
var z = cat(ZONE, f.zone_type_std, ["Autre", "#607d8b", ""])
var ACCENT = z[1]
var title = DefaultValue(f.zone_name, DefaultValue(f.zone_type_raw, z[0]))

var banner = "<div style=\"background:" + ACCENT + "; color:white; padding:10px 12px; border-radius:6px 6px 0 0; margin:0 0 10px 0;\">"
  + "<div style=\"font-size:15px; font-weight:700;\">" + txt(title) + "</div>"
  + "<div style=\"font-size:11px; opacity:0.9; margin-top:2px;\">" + cat(FLAG, f.iso3, "") + " " + txt(f.country) + IIf(!isBlank(f.parent_name), " — " + txt(f.parent_name), "") + "</div>"
  + "<div style=\"font-size:10px; opacity:0.9; margin-top:4px; text-transform:uppercase; letter-spacing:0.8px;\">" + txt(z[0]) + " · " + txt(f.sub_type_raw) + "</div></div>"

var st = cat(STATUS, f.status_std, null)
var chips = chip(txt(z[0]), "#fff", ACCENT)
if (!IsEmpty(st)) { chips += chip(st[0], st[1], st[2]) }
if (f.geom_quality == "bbox") { chips += chip("&#9888; Emprise approximative", "#fbe9e7", "#d84315") }
if (isBlank(f.parent_uid)) { chips += chip("Unité parente non identifiée", "#eceff1", "#607d8b") }
if (f.retired == 1) { chips += chip("Retiré de la source", "#ffebee", "#c62828") }
var chipsHtml = "<div style=\"display:flex; gap:6px; margin-bottom:10px; flex-wrap:wrap;\">" + chips + "</div>"

var crumbs = txt(f.country)
if (!isBlank(f.province)) { crumbs += " › " + txt(f.province) }
if (!isBlank(f.admin2)) { crumbs += " › " + txt(f.admin2) }
if (!isBlank(f.admin3)) { crumbs += " › " + txt(f.admin3) }
if (!isBlank(f.admin4)) { crumbs += " › " + txt(f.admin4) }
var crumbHtml = "<div style=\"background:#f1f8e9; border-radius:6px; padding:7px 8px; margin-bottom:10px; font-size:12px; color:#33691e; font-weight:500;\">&#128205; " + crumbs + "</div>"

// ---------- parent and siblings ---------------------------------------------------------------------
var puid = f.parent_uid
var parent = null; var sib = null; var nSib = 0; var totSib = 0; var rows = null
if (!isBlank(puid)) {
  var pfs = fsGet(P[0], P[1], ["src_uid", "name", "reference", "holder", "community", "status_std", "area_calc_ha", "area_adm_ha", "sub_type_raw", "doc_count"], false)
  if (!IsEmpty(pfs)) { parent = First(Filter(pfs, "src_uid = @puid")) }
  var zfs = fsGet(S[0], S[1], ["parent_uid", "zone_type_std", "area_calc_ha", "retired"], false)
  if (!IsEmpty(zfs)) {
    sib = Filter(zfs, "parent_uid = @puid AND retired = 0")
    nSib = Count(sib)
    if (nSib > 0) {
      rows = OrderBy(GroupBy(sib, ["zone_type_std"], [{ name: "n", expression: "1", statistic: "COUNT" }, { name: "ha", expression: "area_calc_ha", statistic: "SUM" }]), "ha DESC")
      for (var r in rows) { totSib += DefaultValue(r.ha, 0) }
    }
  }
}

var area = f.area_sig_ha
if (isBlank(area) || area <= 0) { area = f.area_adm_ha }
if (isBlank(area) || area <= 0) { area = f.area_calc_ha }
var share = IIf(totSib > 0 && !isBlank(f.area_calc_ha), Round(100 * f.area_calc_ha / totSib, 1), null)
var tiles = "<div style=\"display:flex; gap:6px; margin-bottom:10px; flex-wrap:wrap;\">"
  + tile(DefaultValue(haTxt(area), "—"), "Superficie de la zone", ACCENT)
  + tile(IIf(IsEmpty(share), "—", Text(share) + " %"), "Part de l'unité", "#2e7d32")
  + tile(IIf(nSib > 0, Text(nSib), "—"), "Zones dans l'unité", "#607d8b") + "</div>"

var meaning = "<div style=\"font-size:11px; color:#4b5563; margin:-4px 0 10px 0;\">" + txt(z[2]) + "</div>"

// ---------- donut of the unit ---------------------------------------------------------------------------
var donut = ""
if (nSib > 1 && totSib > 0) {
  var grad = ""; var cum = 0; var legend = ""
  for (var r in rows) {
    var zz = cat(ZONE, r.zone_type_std, ["Autre", "#607d8b", ""])
    var sh = Round(100 * DefaultValue(r.ha, 0) / totSib, 1)
    var start = cum; cum = Round(cum + sh, 1)
    if (grad != "") { grad += ", " }
    grad += zz[1] + " " + start + "% " + cum + "%"
    var me = IIf(r.zone_type_std == f.zone_type_std, " &#9664;", "")
    legend += "<div style=\"display:flex; justify-content:space-between; font-size:11px; margin-bottom:3px;\"><span><span style=\"display:inline-block; width:10px; height:10px; background:" + zz[1] + "; border-radius:2px; margin-right:6px;\"></span>"
      + txt(zz[0]) + " <span style=\"color:#999;\">(" + Text(r.n) + ")</span>" + me + "</span><span style=\"font-weight:700; color:" + zz[1] + ";\">" + haTxt(r.ha) + " · " + sh + " %</span></div>"
  }
  if (cum < 100) { grad += ", #e0e0e0 " + cum + "% 100%" }
  donut = "<div style=\"background:#f7fafa; border-left:4px solid " + P[3] + "; border-radius:4px; margin-bottom:10px; padding:8px 10px 8px 8px;\">"
    + "<div style=\"font-size:10px; font-weight:700; color:" + P[3] + "; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:8px;\">Zonage de l'unité · " + Text(nSib) + " zones · " + haTxt(totSib) + "</div>"
    + "<div style=\"display:flex; align-items:center; gap:14px;\"><div style=\"width:84px; height:84px; flex-shrink:0; border-radius:50%; background:conic-gradient(" + grad + "); display:flex; align-items:center; justify-content:center;\">"
    + "<div style=\"width:54px; height:54px; background:white; border-radius:50%; display:flex; align-items:center; justify-content:center; text-align:center;\"><div><div style=\"font-size:11px; font-weight:700; color:" + ACCENT + ";\">" + IIf(IsEmpty(share), "", Text(share) + " %") + "</div><div style=\"font-size:8px; color:#888;\">cette zone</div></div></div></div>"
    + "<div style=\"flex:1;\">" + legend + "</div></div></div>"
}

// ---------- parent card ------------------------------------------------------------------------------------
var parentCard = ""
if (!IsEmpty(parent)) {
  var pst = cat(STATUS, parent.status_std, null)
  var prow = row("Nom", "<b>" + txt(DefaultValue(parent.name, parent.reference)) + "</b>" + IIf(!isBlank(parent.reference) && parent.reference != parent.name, " · " + txt(parent.reference), ""))
    + row("Type", txt(parent.sub_type_raw)) + row("Attributaire / communauté", txt(DefaultValue(parent.holder, parent.community)))
    + row("Statut", IIf(IsEmpty(pst), "", "<span style=\"background:" + pst[1] + "; color:" + pst[2] + "; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:700;\">" + pst[0] + "</span>"))
    + row("Superficie", haTxt(IIf(isBlank(parent.area_adm_ha), parent.area_calc_ha, parent.area_adm_ha)))
    + row("Documents", IIf(!isBlank(parent.doc_count) && parent.doc_count > 0, Text(parent.doc_count) + " document(s) — voir la fiche de l'unité", ""))
  parentCard = section(P[2], P[3], table(prow))
} else if (isBlank(f.parent_uid)) {
  parentCard = section(P[2], "#9e9e9e", "<div style=\"font-size:11px; color:#888;\">Unité parente non identifiée" + IIf(isBlank(f.parent_ref), "", " (référence source : " + txt(f.parent_ref) + ")") + ".</div>")
} else {
  parentCard = section(P[2], "#9e9e9e", "<div style=\"font-size:11px; color:#888;\">&#9432; couche « " + P[0] + " » introuvable dans la carte (ou unité " + txt(puid) + " absente) : ajoutez la couche parente à la carte ou renseignez ITEM_ID.</div>")
}

var zoneRows = row("Affectation (source)", txt(f.zone_type_raw)) + row("Raison / usage", txt(f.zone_reason)) + row("Code", txt(f.zone_code)) + row("Statut (source)", txt(f.status_raw))
  + row("Exploitant", txt(f.operator)) + row("Superficie SIG (source)", haTxt(f.area_sig_ha)) + row("Superficie administrative", haTxt(f.area_adm_ha)) + row("Superficie calculée", haTxt(f.area_calc_ha))
  + row("Date du plan", dateTxt(f.date_plan)) + row("Programme", txt(f.programme)) + row("Financement / agence", txt(DefaultValue(f.funder, "")) + IIf(isBlank(f.agency), "", " · " + txt(f.agency)))
  + row("Partenaire", txt(f.partner)) + row("Année de référence", IIf(isBlank(f.year_ref), "", Text(f.year_ref)))

var footer = "<div style=\"text-align:center; font-size:10px; color:#aaa; margin-top:10px; padding-top:8px; border-top:1px solid #eee;\">Source : " + txt(f.src_layer)
  + IIf(isBlank(f.src_file), "", " · " + txt(f.src_file)) + IIf(isBlank(f.src_vintage), "", " (" + txt(f.src_vintage) + ")") + IIf(IsEmpty(f.loaded_at), "", " &nbsp;|&nbsp; chargé le " + dateTxt(f.loaded_at))
  + " &nbsp;|&nbsp; situation " + txt(f.situation) + "</div>"

var popup = "<div style=\"font-family:Segoe UI,sans-serif; font-size:13px; color:#1a1a2e;\">" + banner + chipsHtml + meaning + crumbHtml + tiles + donut + parentCard
  + section("Zone", ACCENT, table(zoneRows)) + footer + "</div>"
return { type: "text", text: popup }
